{
  "realm": "videoservice",
  "enabled": true,
  "displayName": "Reel",
  "sslRequired": "none",
  "registrationAllowed": true,
  "registrationEmailAsUsername": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": true,
  "bruteForceProtected": true,
  "failureFactor": 10,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "passwordPolicy": "length(8)",
  "clients": [
    {
      "clientId": "videoservice-web",
      "name": "Reel — web",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "rootUrl": "http://localhost:3000",
      "redirectUris": [
        "http://localhost:3000/auth/callback",
        "http://localhost:5173/auth/callback",
        "http://127.0.0.1:3000/auth/callback",
        "http://127.0.0.1:5173/auth/callback",
        "http://localhost:3000/auth/silent",
        "http://localhost:5173/auth/silent",
        "http://127.0.0.1:3000/auth/silent",
        "http://127.0.0.1:5173/auth/silent"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://localhost:5173",
        "http://127.0.0.1:3000",
        "http://127.0.0.1:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000##http://localhost:5173##http://127.0.0.1:3000##http://127.0.0.1:5173"
      },
      "protocolMappers": [
        {
          "name": "audience-videoservice-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "videoservice-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "videoservice-api",
      "name": "Reel — API (audience)",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    },
    {
      "clientId": "videoservice-cli",
      "name": "Local development only: make demo",
      "description": "Password grant for the end-to-end scenario. Do not use outside the local stack.",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "audience-videoservice-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "videoservice-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
