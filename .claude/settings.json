{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read(**)",
      "Edit(**)",
      "Write(**)",
      "Bash(docker:*)",
      "Bash(docker compose:*)",
      "Bash(curl:*)",
      "Bash(make:*)",
      "Bash(dotnet:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(node:*)",
      "Bash(python3:*)",
      "Bash(ffmpeg:*)",
      "Bash(ffprobe:*)",
      "Bash(mvn:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(mkdir:*)",
      "Bash(mv:*)",
      "Bash(cp:*)",
      "Bash(chmod:*)",
      "Bash(ln:*)",
      "Bash(echo:*)",
      "Bash(sleep:*)",
      "Bash(bash scripts/*)",
      "Bash(./scripts/*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git tag:*)",
      "Bash(git rm:*)",
      "Bash(git reset:*)",
      "Bash(git checkout:*)",
      "Bash(docker system prune:*)",
      "Bash(docker volume rm:*)",
      "Bash(docker volume prune:*)",
      "Bash(rm -rf:*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(sudo:*)",
      "Bash(docker run:*--privileged*)",
      "Bash(docker run:*docker.sock*)",
      "Bash(docker run:*--network host*)",
      "Bash(docker run:*-v /:*)",
      "Bash(curl:*| sh*)",
      "Bash(curl:*| bash*)",
      "Bash(wget:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.config/gcloud/**)",
      "Edit(.git/**)",
      "Edit(~/**)"
    ]
  }
}

