{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://videoservice.local/contracts/events/comment-unliked.v1.json",
  "title": "comment.unliked.v1",
  "description": "A user removed a like from a comment. Written to the likes service outbox in the same transaction as the like change, only when the state actually changes (a repeated request emits nothing). Subscriber: lake. Topic name: comment.unliked.v1; partition key: commentId. Compatibility: only adding optional fields.",
  "type": "object",
  "required": [
    "eventId",
    "occurredAt",
    "schemaVersion",
    "commentId",
    "videoId",
    "commentAuthorId",
    "userId"
  ],
  "additionalProperties": true,
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid",
      "description": "Event ID (UUID v7); the consumer deduplicates by it."
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "description": "Event time, UTC, ISO-8601."
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "traceId": {
      "type": [
        "string",
        "null"
      ],
      "description": "W3C trace id of the request that caused the event; null when absent."
    },
    "commentId": {
      "type": "string",
      "format": "uuid",
      "description": "Comment."
    },
    "videoId": {
      "type": "string",
      "format": "uuid",
      "description": "Video of the comment."
    },
    "commentAuthorId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Keycloak sub of the comment author."
    },
    "userId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Keycloak sub of the user who liked/unliked."
    }
  },
  "examples": [
    {
      "eventId": "3f0c2c1e-8a41-4b5e-9a57-2f6a1c9d7e10",
      "occurredAt": "2026-11-17T10:00:00Z",
      "schemaVersion": 1,
      "traceId": null,
      "commentId": "7a1e5c90-2b3d-4e6f-8a9b-1c2d3e4f5a6b",
      "videoId": "0b7d3a52-6c1e-4f5a-8d2b-9e4f1a2c3b4d",
      "commentAuthorId": "c1b2a3d4-0000-4000-8000-000000000003",
      "userId": "c1b2a3d4-0000-4000-8000-000000000002"
    }
  ]
}
