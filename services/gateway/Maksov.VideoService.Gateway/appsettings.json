{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Web": {
    "PublicUrl": "http://localhost:3000"
  },
  "Auth": {
    "Issuer": "http://localhost:8080/realms/videoservice",
    "Audience": "videoservice-api"
  },
  "ReverseProxy": {
    "Routes": {
      "description": {
        "ClusterId": "analysis",
        "Order": 0,
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/api/videos/{id}/description", "Methods": [ "GET" ] }
      },
      "comments": {
        "ClusterId": "comments",
        "Order": 0,
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/api/videos/{id}/comments/{**catch-all}" }
      },
      "feed": {
        "ClusterId": "feed",
        "Order": 0,
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/api/feed", "Methods": [ "GET" ] }
      },
      "follow": {
        "ClusterId": "friends",
        "Order": 0,
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/api/users/{id}/follow", "Methods": [ "PUT", "DELETE" ] }
      },
      "friends": {
        "ClusterId": "friends",
        "Order": 10,
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/api/friends/{**catch-all}" }
      },
      "user-videos": {
        "ClusterId": "videos",
        "Order": 0,
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/api/users/{id}/videos", "Methods": [ "GET" ] }
      },
      "create-upload": {
        "ClusterId": "videos",
        "Order": 1,
        "AuthorizationPolicy": "authenticated",
        "RateLimiterPolicy": "create-upload",
        "Match": { "Path": "/api/videos", "Methods": [ "POST" ] }
      },
      "videos": {
        "ClusterId": "videos",
        "Order": 10,
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/api/videos/{**catch-all}" }
      },
      "users": {
        "ClusterId": "users",
        "Order": 10,
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/api/users/{**catch-all}" }
      }
    },
    "Clusters": {
      "videos": { "Destinations": { "d1": { "Address": "http://videos:8080/" } } },
      "users": { "Destinations": { "d1": { "Address": "http://users:8080/" } } },
      "analysis": { "Destinations": { "d1": { "Address": "http://analysis:8080/" } } },
      "comments": { "Destinations": { "d1": { "Address": "http://comments:8080/" } } },
      "friends": { "Destinations": { "d1": { "Address": "http://friends:8080/" } } },
      "feed": { "Destinations": { "d1": { "Address": "http://feed:8080/" } } }
    }
  }
}
