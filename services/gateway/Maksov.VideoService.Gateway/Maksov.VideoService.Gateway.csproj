<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- User-facing gateway: single entry point for web and mobile clients. Validates JWT, rate-limits,
       routes /api/* to the videos, users, analysis services. No business logic. -->
  <PropertyGroup>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Maksov.VideoService.Web" />
    <PackageReference Include="Maksov.VideoService.BuildingBlocks" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Maksov.VideoService.Gateway.GraphQL\Maksov.VideoService.Gateway.GraphQL.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Yarp.ReverseProxy" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
  </ItemGroup>

</Project>
