<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Shared libs/ libraries as packages: make pack builds them into artifacts/nuget. -->
    <add key="videoservice-local" value="../../artifacts/nuget" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="videoservice-local">
      <package pattern="Maksov.VideoService.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
