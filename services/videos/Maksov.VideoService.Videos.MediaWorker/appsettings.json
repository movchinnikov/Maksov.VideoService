{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Storage": {
    "Bucket": "media"
  },
  "Transcode": {
    "Threads": 2,
    "MaxConcurrentJobs": 1,
    "Preset": "veryfast",
    "SegmentSeconds": 4,
    "LeaseSeconds": 120,
    "PollSeconds": 15,
    "MaxDurationSeconds": 600,
    "MaxDimension": 4096
  }
}

