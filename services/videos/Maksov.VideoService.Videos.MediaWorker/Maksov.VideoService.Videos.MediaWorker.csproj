<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <RootNamespace>Maksov.VideoService.Videos.MediaWorker</RootNamespace>
    <UserSecretsId>videoservice-media-worker</UserSecretsId>
    <!-- Worker: workstation GC without background mode — less memory, CPU is left to ffmpeg. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Maksov.VideoService.BuildingBlocks" />
    <ProjectReference Include="..\Maksov.VideoService.Videos.Domain\Maksov.VideoService.Videos.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Maksov.VideoService.Videos.MediaWorker.Tests" />
    <InternalsVisibleTo Include="Maksov.VideoService.Videos.Tests" />
  </ItemGroup>

</Project>

