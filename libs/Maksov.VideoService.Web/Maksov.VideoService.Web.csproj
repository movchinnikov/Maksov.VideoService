<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared web layer for all HTTP services: Keycloak JWT, HTTP helpers (UserId, Problem Details), container healthcheck,
       key protection of internal endpoints. No business logic. -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Maksov.VideoService.Web</PackageId>
    <Description>VideoService shared web layer.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Using Include="Microsoft.AspNetCore.Builder" />
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.AspNetCore.Routing" />
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <ProjectReference Include="..\Maksov.VideoService.Primitives\Maksov.VideoService.Primitives.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
  </ItemGroup>

</Project>
