# Local configuration template. `make up` runs scripts/gen-env.sh, which creates .env from this file.
# Secrets (PASSWORD / KEY) are left EMPTY here on purpose: gen-env.sh generates random values on your machine.
# .env is git-ignored. Never commit real secrets; never put them in this file.

# --- PostgreSQL ---
POSTGRES_DB=videoservice
POSTGRES_USER=videoservice
POSTGRES_PASSWORD=

# --- MinIO (S3) ---
MINIO_ROOT_USER=videoservice
MINIO_ROOT_PASSWORD=
# MinIO address used to sign presigned URLs (must be reachable from the browser).
STORAGE_PUBLIC_URL=http://localhost:9000
STORAGE_BUCKET=media
# Web client origins for MinIO CORS (comma-separated).
WEB_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
# MinIO image override (by default — the digest pinned in compose).
# MINIO_IMAGE=

# --- Keycloak ---
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=
# External SSO (optional, applied by the make idps command):
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# --- Upload and transcoding ---
# Maximum file size, bytes (2 GiB).
UPLOAD_MAX_BYTES=2147483648
# x264 threads per job (≈ the media-worker container CPU limit).
TRANSCODE_THREADS=2
TRANSCODE_MAX_CONCURRENT_JOBS=1
TRANSCODE_MAX_DURATION_SECONDS=600

# --- Service databases (each service has its own database and role; the POSTGRES_* superuser is only needed for initialization) ---
VIDEOS_DB_PASSWORD=
USERS_DB_PASSWORD=
ANALYSIS_DB_PASSWORD=
COMMENTS_DB_PASSWORD=
FRIENDS_DB_PASSWORD=

# --- Service-to-service calls (internal endpoints /internal/**, not published outside through the gateway) ---
INTERNAL_API_KEY=

# --- Video description ---
# Frame captioning by a local vision model: none | ollama. For ollama: make up-ml (ollama container + model download).
ANALYSIS_CAPTIONER=none
OLLAMA_MODEL=moondream

# --- Observability (empty — telemetry is off, saving resources) ---
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- make demo ---
DEMO_USER=demo
DEMO_PASSWORD=

